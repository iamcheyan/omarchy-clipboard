#!/usr/bin/env bash
set -euo pipefail

path="${1:-}"
if [[ -z "$path" ]]; then
  echo "usage: iamcheyan-clipboard-paste-path <path>" >&2
  exit 1
fi

# Do not resolve these through PATH: this helper handles clipboard data and
# synthesizes input, so a PATH-precedence executable must not be able to
# intercept either operation. The fixed candidates cover Arch/Omarchy and
# NixOS installations; fail closed when neither location is available.
trusted_executable() {
  local name="$1"
  local candidate
  for candidate in \
    "/usr/bin/$name" \
    "/run/current-system/sw/bin/$name" \
    "/bin/$name"; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  echo "required executable not found in trusted system paths: $name" >&2
  return 1
}

wl_copy="$(trusted_executable wl-copy)"
sleep_bin="$(trusted_executable sleep)"
python3_bin="$(trusted_executable python3)"

# Put the path in the Wayland clipboard as text, then reuse Omarchy's
# universal terminal/non-terminal paste policy.
"$wl_copy" --type text/plain < <(printf '%s' "$path")
"$sleep_bin" 0.15
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../scripts" && pwd)"
exec "$python3_bin" "$script_dir/omarchy-universal-paste.py" paste
